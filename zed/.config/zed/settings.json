{
  "cli_default_open_behavior": "new_window",
  "restore_on_startup": "last_session",
  "auto_install_extensions": {
    "catppuccin": true,
    "codebook": true,
    "git-firefly": true,
    "make": true,
    "toml": true
  },
  "project_panel": {
    "dock": "left"
  },
  "terminal": {
    "font_size": 13.0
  },
  "git": {
    "inline_blame": {
      "enabled": false
    },
    "disable_git": false
  },
  "proxy": "",
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "disable_ai": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "Catppuccin Mocha"
}
