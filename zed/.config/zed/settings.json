{
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "mode": "yolo"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "medium",
        "model": "opus",
        "mode": "auto"
      },
      "type": "registry"
    }
  },
  "agent": {
    "threads_sidebar": {
      "position": "left"
    }
  },
  "soft_wrap": "editor_width",
  "extend_comment_on_newline": false,
  "cli_default_open_behavior": "new_window",
  "restore_on_startup": "last_session",
  "auto_install_extensions": {
    "codebook": true,
    "git-firefly": true,
    "gruvbox-material": true,
    "html": true,
    "latex": true,
    "make": true,
    "neocmake": true,
    "ruby": true,
    "toml": true
  },
  "project_panel": {
    "dock": "left"
  },
  "terminal": {
    "font_size": 13.0,
    "font_fallbacks": ["Symbols Nerd Font Mono"]
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "Gruvbox Material",
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "onSave": true,
            "forwardSearchAfter": true,
            "args": ["-pdf", "-interaction=nonstopmode", "-synctex=1", "%f"]
          },
          "forwardSearch": {
            "executable": "tex-forward-search",
            "args": ["%l", "%p", "%f"]
          }
        }
      }
    }
  }
}
