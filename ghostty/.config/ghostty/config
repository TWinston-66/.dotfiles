theme = gruvbox-material

font-size = 13
adjust-cell-height = 10%

window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

shell-integration = detect
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path

# A command that ran 5s or more is announced by .zshrc (OSC 777, through tmux);
# Ghostty's own notify-on-command-finish can't see commands inside tmux.

window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

scrollback-limit = 100000000

# precision = touchpad (default 1), discrete = mouse wheel notches (default 3).
mouse-scroll-multiplier = precision:0.5,discrete:2

keybind = cmd+a=text:\x01

keybind = cmd+y=text:\x19
