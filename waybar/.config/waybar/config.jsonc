{
  "layer": "top",
  "position": "top",
  "height": 28,
  "margin-top": 4,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 5,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "wireplumber", "custom/sunset", "backlight", "network", "power-profiles-daemon", "battery", "custom/power"],

  "hyprland/workspaces": {
    "format": "{id}"
  },

  "clock": {
    "format": "{:%a %b %d  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "weekdays": "<span color='#a6adc8'>{}</span>",
        "days": "<span color='#bac2de'>{}</span>",
        "today": "<span color='#89b4fa'><b><u>{}</u></b></span>"
      }
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  // lattice-sunset emits the JSON and signals RTMIN+1 after every change, so the bar
  // updates on click instead of waiting out an interval. It queries hyprsunset itself,
  // so an external `hyprctl hyprsunset` still shows up here within the interval.
  "custom/sunset": {
    "exec": "lattice-sunset status",
    "return-type": "json",
    "signal": 1,
    "interval": 30,
    "on-click": "lattice-sunset toggle"
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  // Readout only -- no on-scroll handlers, so scrolling past the bar can't nudge the
  // backlight. Brightness is changed with XF86MonBrightness{Up,Down}, bound in
  // ~/.dotfiles/hypr/hyprland.lua, which raise the same swayosd popup.
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },

  "network": {
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰤮 offline",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format": "{ifname}  {ipaddr}/{cidr}"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
      "performance": "󰓅 perf",
      "balanced": "󰾅 balanced",
      "power-saver": "󰾆 saver"
    }
  },

  // lattice-power toggles wlogout, which is themed from the lattice flake rather than
  // from here -- wlogout ignores XDG_CONFIG_DIRS, so the wrapper passes it the paths.
  // Bare `wlogout` would open with its stock theme, and the command has to be on
  // waybar's systemd PATH; both are handled in modules/nixos/profiles/graphical.nix.
  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Session",
    "on-click": "lattice-power"
  },

  "battery": {
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}"
  }
}
