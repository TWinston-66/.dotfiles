{
  "layer": "top",
  "position": "top",
  "height": 28,
  "margin-top": 4,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 5,
  // Restyles in place when style.css or anything it @imports changes -- which is how the
  // runtime theme (lattice-palette) reaches the bar without a SIGUSR2 rebuilding it.
  "reload_style_on_change": true,

  // The centre group holds the clock and nothing else, which is what pays for the right
  // side. waybar centres modules-center as a group, so a module put beside the clock has
  // to be balanced by the same width on the clock's other side to keep the clock on the
  // bar's centre line -- every pill in here costs its width twice, and half of that is
  // spent pushing the group's right edge towards the right-hand group. Alone, the clock
  // reaches only 71px either side of centre and the right side gets ~130px back.
  //
  // So the three click-toggles and the weather moved to the left group, which is anchored
  // to the left edge and had ~210px going spare the moment the window title came out.
  // They stay in one run, weather last, so it is still the pill next to the clock and
  // "what time is it" and "what is it doing outside" are still one glance apart.
  "modules-left": ["hyprland/workspaces", "privacy", "custom/capslock", "custom/sunset", "custom/dnd", "custom/idle", "custom/wallpaper", "custom/theme", "custom/vault", "custom/backup", "custom/bitwarden", "custom/weather"],
  "modules-center": ["custom/clock"],
  "modules-right": ["tray", "wireplumber", "wireplumber#mic", "backlight", "network", "custom/tailscale", "custom/power-profile", "custom/battery", "custom/power"],

  // The number alone says where a window is but not what it is, which stops being enough
  // as soon as three or four workspaces are in use at once. {windows} appends one glyph
  // per open window, so a pill reads "2 󰈹" -- number first, so the SUPER+[1-5] target
  // is still the thing the eye lands on. Empty persistent pills render the id and nothing
  // else, and keep their .empty styling.
  //
  // Rules are matched against the Wayland app_id, not the X11 WM_CLASS, and the two differ
  // for some apps -- the classes below are the ones `hyprctl clients` reports. Anything
  // unmatched draws window-rewrite-default rather than disappearing, which is the signal
  // to come back here and add it. The patterns are ECMAScript regex wrapped in .* so they
  // hold whether waybar searches or anchors them.
  //
  // A rule naming both class and title outranks a class-only rule whatever the order here,
  // so the three Firefox web apps (modules/nixos/webapps.nix -- they are Taskbar Tabs and
  // report app_id "firefox" like any other window) win over the plain Firefox rule. They
  // match on title, so an ordinary tab titled "... Calendar ..." wears the calendar mark
  // too; harmless, and the alternative is no mark for the web apps at all.
  "hyprland/workspaces": {
    "format": "{id} {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "window-rewrite": {
      "class<foot>": "",
      "class<firefox> title<.*Gemini.*>": "󰚩",
      "class<firefox> title<.*Reminders.*>": "󰄹",
      "class<firefox> title<.*Calendar.*>": "󰸗",
      "class<firefox>": "󰈹",
      "class<thunderbird>": "󰇮",
      "class<thunar>": "󰉋",
      "class<.*zathura>": "󰈦",
      "class<mpv>": "󰎁",
      "class<imv>": "󰋩",
      "class<coda-qt>": "󰈙",
      "class<draw.io>": "",
      "class<.*[Tt]elegram.*>": "",
      "class<.*[Vv]esktop.*>": "󰙯",
      "class<.*[Bb]itwarden.*>": "󰌾",
      "class<qalculate-gtk>": "󰂽",
      "class<xarchiver>": "󰗄",
      "class<.*[Cc]ode.*>": "󰨞"
    }
  },

  // Sits between the workspaces and the toggles rather than on the right, which is full.
  // Takes zero width while nothing is capturing, so it costs nothing at rest and simply
  // appears when something starts. It shoves the toggles right by its own width while it
  // is up; that is the price of keeping it near the left edge, where a capture in progress
  // is the thing most worth noticing.
  //
  // Default modules are screenshare + audio-in, which is what is wanted: audio-out would
  // light up for any music playing. icon-size 15 to sit on a 28px bar -- the default 20
  // is sized for a taller one.
  "privacy": {
    "icon-size": 15,
    "icon-spacing": 6,
    "transition-duration": 200
  },

  // Caps lock, for the keyboards without an LED for it. Only on the bar while it is on --
  // lattice-capslock prints empty text otherwise -- so it sits with privacy, the other pill
  // that is only there to say something is happening. See modules/nixos/profiles/graphical.nix.
  "custom/capslock": {
    "exec": "lattice-capslock",
    "return-type": "json",
    "tooltip": true
  },

  // The clock, from lattice-clock rather than waybar's built-in module: that one's calendar
  // colours could only be literals here, and this file is only re-read on a full reload.
  // lattice-clock draws the hover calendar from the run-time theme and redraws it when the
  // theme changes. A click opens lattice-calendar, the month with previous / today / next
  // buttons under it. Both in modules/nixos/profiles/graphical.nix.
  "custom/clock": {
    "exec": "lattice-clock",
    "return-type": "json",
    "tooltip": true,
    "on-click": "lattice-calendar"
  },

  // Weather, from Open-Meteo via lattice-weather -- see modules/nixos/profiles/graphical.nix
  // for the script and modules/nixos/weather.nix for the coordinates. The exec emits the
  // glyph, both temperatures and a class per temperature band; nothing here spells the
  // conditions out, because the glyph and the colour in style.css already carry them.
  //
  // Last in the left group, so it is still the pill the clock is read next to: "what time
  // is it" and "what is it doing outside" get answered in the same glance. It used to sit
  // on the clock's right in modules-center, balanced by an invisible custom/spacer module;
  // both are gone, because a pill in the centre group costs its width twice and the right
  // side needed the room. See the note on modules-center at the top.
  //
  // Kept to the glyph and the temperature, with the feels-like reading in the tooltip: the
  // backup pill appearing earlier in the run used to push a wider version of this pill into
  // the clock.
  //
  // interval 900 is the API's own cadence, not a guess: Open-Meteo stamps its `current`
  // block "interval":900, so a faster poll returns the same numbers. A click doesn't have to
  // wait it out -- lattice-weather refresh signals RTMIN+3 and waybar re-runs the exec.
  "custom/weather": {
    "exec": "lattice-weather status",
    "return-type": "json",
    "signal": 3,
    "interval": 900,
    "on-click": "lattice-weather refresh"
  },

  // 14px rather than the stock 16: at 16 the tray's icon rendered visibly larger than the
  // Nerd Font glyphs in the pills beside it. It also has to stay small -- the tray is the
  // leftmost pill of an already-full right group, and a wider icon squeezes the network
  // label until waybar ellipsizes the SSID to make room.
  "tray": {
    "icon-size": 14,
    "spacing": 8
  },

  // lattice-sunset emits the JSON and signals RTMIN+1 after every change, so the bar
  // updates on click instead of waiting out an interval. It queries hyprsunset itself,
  // so an external `hyprctl hyprsunset` still shows up here within the interval.
  //
  // Lives in the left group, next to custom/dnd, custom/idle and the weather. It sat in
  // modules-center beside the clock until the right side ran out of room; see the note on
  // modules-center at the top for why the centre is the expensive place to put a pill.
  "custom/sunset": {
    "exec": "lattice-sunset status",
    "return-type": "json",
    "signal": 1,
    "interval": 30,
    "on-click": "lattice-sunset toggle"
  },

  // Do not disturb. The whole of the mechanism is `[mode=dnd] invisible=1` in
  // ~/.dotfiles/mako -- lattice-dnd only flips mako's mode and signals here, so mako owns
  // the state and this pill reads it back rather than tracking it. Same contract as
  // custom/sunset above, and the same reason: a pill that keeps its own copy can disagree
  // with the thing it claims to describe.
  //
  // The tooltip counts what is waiting, which is not the same as what was missed. A hidden
  // notification is still live, so the count is what will appear the moment the mode goes
  // off; a normal notification that timed out while it was on is already in the history,
  // and SUPER+ALT+N is where that lives.
  "custom/dnd": {
    "exec": "lattice-dnd status",
    "return-type": "json",
    "signal": 4,
    "interval": 30,
    "on-click": "lattice-dnd toggle"
  },

  // Sits next to custom/sunset and custom/dnd in the left group because all three are
  // click-toggles rather than readouts, and like those two it is a lattice-* script rather
  // than a built-in.
  //
  // The built-in idle_inhibitor was here until the Stream Deck grew a key for the same
  // thing and the two could not be made to agree: waybar's inhibitor is a
  // zwp_idle_inhibit_manager_v1 lock held on waybar's own surface, and nothing outside
  // waybar can read it or let it go. lattice-idle stops hypridle instead -- the thing that
  // actually locks, blanks and dims -- which is a state both surfaces can read. Same two
  // glyphs, same colours, and now the pill follows a press on the deck.
  //
  // Icon-only to save bar width; the colour carries the state. The interval is a backstop
  // for a hypridle stopped from somewhere else entirely; the signal is what makes a click
  // land immediately.
  "custom/idle": {
    "exec": "lattice-idle status",
    "return-type": "json",
    "signal": 5,
    "interval": 30,
    "on-click": "lattice-idle toggle"
  },

  // The wallpaper. An action rather than a toggle -- the pool has fourteen members and
  // none of them is an "on" -- so there is no state to read back and the module is a
  // static format with click handlers, the shape custom/power has for the same reason.
  //
  // Left click is `next`, which is exactly what the deck's paper key runs; right click
  // opens lattice-wallpaper-menu, a rofi list of the pool by accent name with a swatch
  // per row and the one already up marked, hung under the left end of the bar the way
  // the Wi-Fi and audio pickers hang under the right. Middle click re-rolls, because
  // stepping to the ninth of fourteen one click at a time is not a way to change the
  // wallpaper -- `random` skips whatever is up, so a re-roll always lands somewhere new.
  //
  // Last of the toggles and before the weather, so the run still ends on the pill the
  // clock is read next to. See modules/nixos/profiles/graphical.nix for all three verbs.
  "custom/wallpaper": {
    "format": "󰸉",
    "tooltip": true,
    "tooltip-format": "Wallpaper",
    "on-click": "lattice-wallpaper next",
    "on-click-right": "lattice-wallpaper-menu",
    "on-click-middle": "lattice-wallpaper random"
  },

  // The flavour, the wallpaper pill's other half: that one moves the accent, this one the
  // whole palette under it -- bar, borders, menus, lock screen, terminal, tmux and nvim.
  // Left click steps to the next flavour, right click opens lattice-theme-menu, a strip of
  // each flavour's colours hung where the wallpaper menu hangs. Both keep the wallpaper
  // that is up and redraw it in the new flavour. See lattice-theme in
  // modules/nixos/profiles/graphical.nix.
  "custom/theme": {
    "format": "󰏘",
    "tooltip": true,
    "tooltip-format": "Theme",
    "on-click": "lattice-theme next",
    "on-click-right": "lattice-theme-menu"
  },

  // The Obsidian vault's git state: uncommitted files as a count, then ↑ for commits not
  // pushed and ↓ for commits on GitHub not pulled, coloured by the worst of them. A
  // readout rather than a toggle, so it sits after them and before the weather. The script
  // checks GitHub on its own every five minutes and signals RTMIN+7 when it has; the
  // interval only re-reads the working tree. Click fetches now, right-click opens lazygit
  // in the vault. See lattice-vault in modules/nixos/desktop/bar.nix.
  "custom/vault": {
    "exec": "lattice-vault status",
    "return-type": "json",
    "signal": 7,
    "interval": 10,
    "on-click": "lattice-vault fetch",
    "on-click-right": "lattice-vault open"
  },

  // Backups to the external drive (modules/nixos/backup.nix). Hidden unless there is
  // something to see: the drive is plugged in, the last run failed, or the last backup is
  // a week old. The text is the age of the last backup, or progress while one runs;
  // the tooltip has the rest. The runner signals RTMIN+9 on every change, so the interval
  // is only for the age ticking over. Click backs up now, right-click is the menu
  // (browse, check, eject).
  "custom/backup": {
    "exec": "lattice-backup bar",
    "return-type": "json",
    "signal": 9,
    "interval": 30,
    "on-click": "lattice-backup now",
    "on-click-right": "lattice-backup-menu"
  },

  // Bitwarden, out of the tray and into a pill of its own -- the tray module draws every
  // icon in one box, so the app's tray icon is off and lattice-bitwarden stands in. The
  // glyph is the lock state as the SSH agent sees it; click shows or hides the app's
  // window, which lives on special:bitwarden (a rule in ~/.dotfiles/hypr), or starts the
  // app if it is down. See modules/nixos/bitwarden.nix.
  //
  // A minute, not ten seconds: every poll is an `ssh-add -l` that wakes the Electron app
  // and logs a line, times two bars when docked. A click repaints it at once through the
  // signal, so only a lock or unlock done in the app itself waits for the next tick.
  "custom/bitwarden": {
    "exec": "lattice-bitwarden status",
    "return-type": "json",
    "signal": 8,
    "interval": 60,
    "on-click": "lattice-bitwarden toggle"
  },

  // Muted keeps only the glyph: the word made this the widest state the pill can be in,
  // and dropping it is what buys the room on the right for custom/tailscale below. The
  // glyph is still greyed by the .muted class in style.css.
  //
  // Click for the output picker: lattice-audio lists the sinks PipeWire knows about
  // through rofi, marks the one in use and moves what is already playing over when
  // another is chosen -- the same shape as the Wi-Fi pill, which is the other bar surface
  // whose job is "switch this to something else". Mute moves to the right button and to
  // the menu's first row; the keyboard still has XF86AudioMute for it.
  //
  // Scroll does nothing, for the same reason backlight has no scroll handlers -- a stray
  // wheel tick on the way past the bar shouldn't move the volume.
  // Unlike backlight, this module changes volume in C++ whether or not anything is
  // configured, so the mechanic can't just be left unconfigured: the only thing that
  // displaces it is a scroll handler of our own, which is what these two are. They are
  // empty on purpose and cost nothing -- waybar's forkExec returns early on an empty
  // command, so no shell is spawned per tick -- and with them present scroll-step has
  // nothing left to scale, so it's gone.
  //
  // The right-click mute goes through lattice-deck rather than straight at wpctl so the
  // Stream Deck's mute key follows it; see the microphone pill below.
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "lattice-audio output",
    "on-click-right": "lattice-deck mute",
    "on-scroll-up": "",
    "on-scroll-down": ""
  },

  // The microphone, as the same module pointed at the default source instead of the
  // default sink -- node-type is the whole difference, and the "#mic" suffix is what lets
  // wireplumber appear twice. Deliberately the sink pill's pair: same shape, same
  // glyph-only muted state, so the two are read together rather than as two unrelated
  // readouts that happen to be adjacent.
  //
  // Click for the input picker, right-click to mute -- the same pair as the sink pill, and
  // `lattice-audio input` is the same script with node-type's counterpart on the pactl
  // side. It drops the monitor sources, which are the loopback of each sink and would
  // otherwise fill the list with a copy of the output menu.
  //
  // Both pills mute through lattice-deck rather than wpctl. The Stream Deck has a key for
  // each and only knows what it is told, so a mute from the bar would otherwise leave it
  // showing the old state until its five-minute sync came round -- the same reason
  // XF86AudioMute and XF86AudioMicMute go through lattice-deck in ~/.dotfiles/hypr.
  //
  // Icon-only, unlike the sink beside it. The level is not the question this pill answers
  // -- input gain is set once and left, where output volume moves all day -- and "󰍬 100%"
  // is 64px against the glyph's 35. That difference is the whole of the Dell's clearance:
  // with it, the right group reaches the clock there at full volume and full brightness.
  // SHIFT+XF86AudioRaiseVolume raises swayosd's own pill with the number on it, which is
  // where a level belongs -- at the moment it changes.
  //
  // Scroll is stubbed for the reason the sink's is: this module changes volume in C++
  // whether or not anything is configured, and an empty handler is the only thing that
  // displaces it. waybar's forkExec returns early on an empty command, so no shell is
  // spawned per tick.
  "wireplumber#mic": {
    "node-type": "Audio/Source",
    "format": "󰍬",
    "format-muted": "󰍭",
    "on-click": "lattice-audio input",
    "on-click-right": "lattice-deck mic",
    "on-scroll-up": "",
    "on-scroll-down": ""
  },

  // Readout only. Brightness is changed with XF86MonBrightness{Up,Down}, bound in
  // ~/.dotfiles/hypr/hyprland.lua, which raise the same swayosd popup a volume key does.
  //
  // The two empty scroll handlers are what make it readout-only, and leaving them out is
  // not the same thing: this module dims the screen in C++ whether or not anything is
  // configured (Backlight::handleScroll goes straight to logind's SetBrightness), and the
  // only thing that displaces it is a handler of our own -- its guard is
  // `config_["on-scroll-up"].isString()`, and "" is a string. Empty ones cost nothing,
  // because waybar's forkExec returns early on an empty command rather than spawning a
  // shell per tick. Exactly the pair the wireplumber pills carry, and for exactly that
  // reason; the note there has the rest of it.
  //
  // Worth having because the bar is a 28px strip along the top edge of the screen, which
  // is where a pointer travels on its way to anything at the top of a window -- so a
  // wheel tick on the way past is an accident rather than a request, and "the screen just
  // dimmed and I don't know why" is a poor thing for a readout to be able to do.
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "",
    "on-scroll-down": ""
  },

  // 16, up from 13. The cap used to be the tightest thing on the bar -- the right group
  // cleared the clock by ~19px with volume and backlight both at 100%, so the SSID was
  // what gave. Emptying the centre group down to the clock handed ~130px back, and after
  // the microphone pill took its share this is where the rest went. Longer names still
  // ellipsize; the full name and the address stay in the tooltip.
  //
  // 16 and not more because the cap is shared and the Dell's screen is 64 logical px
  // narrower. Measured on this panel, at the cap, with volume and backlight at 100%: the
  // pill runs 6.5px per unit of max-length, and the right group clears the clock by ~42px
  // here and ~13px there. 18 would put the Dell's group against the clock, and GTK answers
  // that by squeezing the centre child -- the clock visibly narrows rather than the SSID
  // giving way. Re-measure before raising it.
  //
  // Click for the picker: lattice-wifi lists what is in range through rofi, which is
  // themed and lets an SSID be found by typing. See modules/nixos/profiles/graphical.nix.
  "network": {
    "on-click": "lattice-wifi",
    "max-length": 16,
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰤮 offline",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format": "{ifname}  {ipaddr}/{cidr}"
  },

  // Tailscale has no Linux GUI, so the pill is the interface: hover for the connection
  // report, click to bring the tunnel up or down, right-click for the admin console. The
  // glyph and colour are chosen by lattice-tailscale per state, so nothing here spells the
  // state out -- the script emits `text` and the class style.css keys off. It signals
  // RTMIN+2 itself after a toggle, so the interval is only a safety net for changes made
  // from a shell. Icon-only, and sits just right of network; see the network note above.
  "custom/tailscale": {
    "exec": "lattice-tailscale status",
    "return-type": "json",
    "signal": 2,
    "interval": 30,
    "on-click": "lattice-tailscale toggle",
    "on-click-right": "lattice-tailscale web"
  },

  // The power profile, and -- on hover -- what the machine is doing with it: four
  // sparklines over the last two minutes (load, each core cluster's clock, and the
  // package's own draw in watts), then the fans, the hottest sensor that names itself and
  // the battery. lattice-power-profile emits the lot as one JSON object; the script, and
  // why this is a custom module at all, are in modules/nixos/profiles/graphical.nix.
  //
  // Waybar's own power-profiles-daemon module was here and drew the same three glyphs. It
  // could not grow this tooltip: its tooltip-format takes exactly one placeholder,
  // {profile}, and nothing that reaches sysfs.
  //
  // Icon-only, as that one was: the three glyphs are distinct enough to read at a glance,
  // and dropping the labels frees ~42px on a 1280px-wide bar -- which is what makes room
  // for custom/idle without the right side colliding with the centred clock. The profile's
  // name is still one hover away, now at the head of the graphs.
  //
  // interval 2 is the graph's sample rate rather than a refresh rate. The script keeps a
  // 60-sample window in XDG_RUNTIME_DIR and each tick is one column of it, so a hover shows
  // the two minutes that have already happened instead of starting a graph when the
  // pointer arrives -- which is also why the sampling cannot be made lazy. `width` and
  // `period` in the script are the other half of that arithmetic: change one, change both.
  //
  // The signal is what makes a click land at once; the click itself cycles through
  // lattice-deck, so the deck's profile key and this pill cannot disagree.
  "custom/power-profile": {
    "exec": "lattice-power-profile status",
    "return-type": "json",
    "signal": 6,
    "interval": 2,
    "on-click": "lattice-power-profile cycle"
  },

  // lattice-power toggles wlogout, which is themed from the lattice flake rather than
  // from here -- wlogout ignores XDG_CONFIG_DIRS, so the wrapper passes it the paths.
  // Bare `wlogout` would open with its stock theme, and the command has to be on
  // waybar's systemd PATH; both are handled in modules/nixos/profiles/graphical.nix.
  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Session",
    "on-click": "lattice-power"
  },

  // The battery, from lattice-battery-pill rather than waybar's built-in module: that one
  // works the percentage out from energy_now / energy_full and never reads the kernel's
  // capacity, so on the Mac it read 77% while upower, fastfetch and the power-profile
  // tooltip all read 80%. The script sets the charging / plugged / warning / critical
  // classes the stylesheet colours. See modules/nixos/profiles/graphical.nix.
  "custom/battery": {
    "exec": "lattice-battery-pill",
    "return-type": "json",
    "tooltip": true
  }
}
