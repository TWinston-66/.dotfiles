{
  "layer": "top",
  "position": "top",
  "height": 28,
  "margin-top": 4,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 5,

  "modules-left": ["hyprland/workspaces", "privacy", "hyprland/window"],
  "modules-center": ["custom/spacer", "custom/sunset", "idle_inhibitor", "clock", "custom/weather"],
  "modules-right": ["tray", "wireplumber", "backlight", "network", "custom/tailscale", "power-profiles-daemon", "battery", "custom/power"],

  // The number alone says where a window is but not what it is, which stops being enough
  // as soon as three or four workspaces are in use at once. {windows} appends one glyph
  // per open window, so a pill reads "2 󰈹" -- number first, so the SUPER+[1-5] target
  // is still the thing the eye lands on. Empty persistent pills render the id and nothing
  // else, and keep their .empty styling.
  //
  // Rules are matched against the Wayland app_id, not the X11 WM_CLASS, and the two differ
  // for some apps -- the classes below are the ones `hyprctl clients` reports. Anything
  // unmatched draws window-rewrite-default rather than disappearing, which is the signal
  // to come back here and add it. The patterns are ECMAScript regex wrapped in .* so they
  // hold whether waybar searches or anchors them.
  //
  // A rule naming both class and title outranks a class-only rule whatever the order here,
  // so the three Firefox web apps (modules/nixos/webapps.nix -- they are Taskbar Tabs and
  // report app_id "firefox" like any other window) win over the plain Firefox rule. They
  // match on title, so an ordinary tab titled "... Calendar ..." wears the calendar mark
  // too; harmless, and the alternative is no mark for the web apps at all.
  "hyprland/workspaces": {
    "format": "{id} {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "window-rewrite": {
      "class<com.mitchellh.ghostty>": "",
      "class<firefox> title<.*Gemini.*>": "󰚩",
      "class<firefox> title<.*Reminders.*>": "󰄹",
      "class<firefox> title<.*Calendar.*>": "󰸗",
      "class<firefox>": "󰈹",
      "class<thunderbird>": "󰇮",
      "class<thunar>": "󰉋",
      "class<.*zathura>": "󰈦",
      "class<mpv>": "󰎁",
      "class<imv>": "󰋩",
      "class<libreoffice.*>": "󰈙",
      "class<draw.io>": "",
      "class<.*[Tt]elegram.*>": "",
      "class<.*[Vv]esktop.*>": "󰙯",
      "class<.*[Bb]itwarden.*>": "󰌾",
      "class<qalculate-gtk>": "󰂽",
      "class<xarchiver>": "󰗄",
      "class<.*[Cc]ode.*>": "󰨞"
    }
  },

  // Sits between the workspaces and the title rather than on the right, which is full.
  // Takes zero width while nothing is capturing, so it costs nothing at rest and simply
  // appears when something starts. Placed ahead of the title so it lands in the same spot
  // every time instead of drifting with the title's length.
  //
  // Default modules are screenshare + audio-in, which is what is wanted: audio-out would
  // light up for any music playing. icon-size 15 to sit on a 28px bar -- the default 20
  // is sized for a taller one.
  "privacy": {
    "icon-size": 15,
    "icon-spacing": 6,
    "transition-duration": 200
  },

  // The left side had ~486px of dead space between the workspaces pill and the centred
  // clock, which is the only reason there is room for this; the right side is full.
  //
  // 26 chars, down from 35: the workspace pills now carry a glyph per window, so they are
  // no longer a fixed 162px. Four occupied workspaces holding two windows each come to
  // ~260px, and with the privacy module up (~85px) that leaves ~140px here -- about 26
  // chars of JetBrains Mono at 12px. The title is deliberately the module that gives: it
  // ellipsises, and it is the one thing on the bar that is also visible in the window
  // itself.
  //
  // Firefox separates the title from the app name with an em dash, not a hyphen -- the
  // rewrite below will silently not match if that is ever retyped as "-". Rules are
  // ECMAScript regex over the whole title, and a title that matches nothing is left alone.
  "hyprland/window": {
    "format": "{}",
    "max-length": 26,
    "separate-outputs": true,
    "rewrite": {
      "(.*) \u2014 Mozilla Firefox": "$1",
      "(.*) \u2014 Mozilla Thunderbird": "$1",
      "(.*) - Visual Studio Code": "$1"
    }
  },

  "clock": {
    "format": "{:%a %b %d  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "weekdays": "<span color='#a6adc8'>{}</span>",
        "days": "<span color='#bac2de'>{}</span>",
        "today": "<span color='#89b4fa'><b><u>{}</u></b></span>"
      }
    }
  },

  // Invisible counterweight, and the reason the clock lands on the bar's centre line.
  // waybar centres modules-center as a group, not the clock inside it, so the clock is only
  // centred when the content either side of it is the same width. custom/weather is wider
  // than custom/sunset and idle_inhibitor together, so the shortfall is on the left and
  // this makes it up; it drew the same job from the right before the weather pill existed.
  //
  // The exec has to emit a character -- waybar sizes a custom module to its output, and an
  // empty one collapses to zero whatever the format says. "x" is hidden by the transparent
  // colour in style.css, where the padding is sized to match.
  "custom/spacer": {
    "exec": "echo x",
    "format": "{}",
    "tooltip": false
  },

  // Weather, from Open-Meteo via lattice-weather -- see modules/nixos/profiles/graphical.nix
  // for the script and modules/nixos/weather.nix for the coordinates. The exec emits the
  // glyph, both temperatures and a class per temperature band; nothing here spells the
  // conditions out, because the glyph and the colour in style.css already carry them.
  //
  // Paired with the clock rather than filed on the right: "what time is it" and "what is it
  // doing outside" get read in the same glance, and the right group has no room. It takes
  // the space custom/spacer used to occupy; that module is still here, moved to the head of
  // the group to counterweight this one -- see its note above.
  //
  // lattice-weather right-aligns both temperatures in a three-character field, so this pill
  // is a constant width whatever the reading is. That is load-bearing: the counterweight is
  // a fixed padding, so a pill that grew by a character at -5° would walk the clock off
  // centre. Do not "tidy up" the padding in the script's printf without re-measuring.
  //
  // interval 900 is the API's own cadence, not a guess: Open-Meteo stamps its `current`
  // block "interval":900, so a faster poll returns the same numbers. A click doesn't have to
  // wait it out -- lattice-weather refresh signals RTMIN+3 and waybar re-runs the exec.
  "custom/weather": {
    "exec": "lattice-weather status",
    "return-type": "json",
    "signal": 3,
    "interval": 900,
    "on-click": "lattice-weather refresh"
  },

  // 14px rather than the stock 16: at 16 the tray's icon rendered visibly larger than the
  // Nerd Font glyphs in the pills beside it. It also has to stay small -- the tray is the
  // leftmost pill of an already-full right group, and a wider icon squeezes the network
  // label until waybar ellipsizes the SSID to make room.
  "tray": {
    "icon-size": 14,
    "spacing": 8
  },

  // lattice-sunset emits the JSON and signals RTMIN+1 after every change, so the bar
  // updates on click instead of waiting out an interval. It queries hyprsunset itself,
  // so an external `hyprctl hyprsunset` still shows up here within the interval.
  //
  // Lives in modules-center just left of the clock: centring the group rather than the
  // clock alone is what tucks these two against the clock and gives the right side its
  // room back. This used to cost ~41px of clock centring; custom/spacer at the head of the
  // group now makes that back, so the clock is on the centre line to within a pixel.
  "custom/sunset": {
    "exec": "lattice-sunset status",
    "return-type": "json",
    "signal": 1,
    "interval": 30,
    "on-click": "lattice-sunset toggle"
  },

  // Sits next to custom/sunset because both are click-toggles rather than readouts.
  // Holds a zwp_idle_inhibit_manager_v1 lock on waybar's own surface, which suppresses
  // ext_idle_notifier_v1 -- so this stops hypridle's 300s lock and 900s
  // suspend-then-hibernate, not just the screen blank. Icon-only to save bar width; the
  // colour carries the state.
  "idle_inhibitor": {
    "format": "{icon}",
    "tooltip-format-activated": "Staying awake",
    "tooltip-format-deactivated": "Idle timers active",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    }
  },

  // Muted keeps only the glyph: the word made this the widest state the pill can be in,
  // and dropping it is what buys the room on the right for custom/tailscale below. The
  // glyph is still greyed by the .muted class in style.css.
  //
  // Click to mute; scroll does nothing, for the same reason backlight has no scroll
  // handlers -- a stray wheel tick on the way past the bar shouldn't move the volume.
  // Unlike backlight, this module changes volume in C++ whether or not anything is
  // configured, so the mechanic can't just be left unconfigured: the only thing that
  // displaces it is a scroll handler of our own, which is what these two are. They are
  // empty on purpose and cost nothing -- waybar's forkExec returns early on an empty
  // command, so no shell is spawned per tick -- and with them present scroll-step has
  // nothing left to scale, so it's gone.
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "",
    "on-scroll-down": ""
  },

  // Readout only -- no on-scroll handlers, so scrolling past the bar can't nudge the
  // backlight. Brightness is changed with XF86MonBrightness{Up,Down}, bound in
  // ~/.dotfiles/hypr/hyprland.lua, which raise the same swayosd popup.
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },

  // custom/tailscale sits to its right, and with custom/sunset and idle_inhibitor moved
  // to the centre the pair clears the clock by ~43px in a typical state on this
  // 1280px-logical screen -- measured off a screenshot, not guessed. Still ~36px with
  // volume and battery both at 100%, and the SSID label ellipsizes rather than let the
  // group reach the clock. 13 chars covers the icon, a space and an 11-char SSID;
  // anything longer is truncated. Full name and address stay in the tooltip.
  //
  // Click for the picker: lattice-wifi lists what is in range through rofi, which is
  // themed and lets an SSID be found by typing. See modules/nixos/profiles/graphical.nix.
  "network": {
    "on-click": "lattice-wifi",
    "max-length": 13,
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰤮 offline",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format": "{ifname}  {ipaddr}/{cidr}"
  },

  // Tailscale has no Linux GUI, so the pill is the interface: hover for the connection
  // report, click to bring the tunnel up or down, right-click for the admin console. The
  // glyph and colour are chosen by lattice-tailscale per state, so nothing here spells the
  // state out -- the script emits `text` and the class style.css keys off. It signals
  // RTMIN+2 itself after a toggle, so the interval is only a safety net for changes made
  // from a shell. Icon-only, and sits just right of network; see the network note above.
  "custom/tailscale": {
    "exec": "lattice-tailscale status",
    "return-type": "json",
    "signal": 2,
    "interval": 30,
    "on-click": "lattice-tailscale toggle",
    "on-click-right": "lattice-tailscale web"
  },

  // Icon-only: the three glyphs are distinct enough to read at a glance, and dropping the
  // labels frees ~42px on a 1280px-wide bar -- which is what makes room for
  // idle_inhibitor without the right side colliding with the centred clock. The profile
  // name is still one hover away.
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    }
  },

  // lattice-power toggles wlogout, which is themed from the lattice flake rather than
  // from here -- wlogout ignores XDG_CONFIG_DIRS, so the wrapper passes it the paths.
  // Bare `wlogout` would open with its stock theme, and the command has to be on
  // waybar's systemd PATH; both are handled in modules/nixos/profiles/graphical.nix.
  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Session",
    "on-click": "lattice-power"
  },

  "battery": {
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}"
  }
}
