Host *
  IgnoreUnknown UseKeychain
  AddKeysToAgent yes
  UseKeychain yes

# The private key is a file on macOS, and ssh loads it from there. On lattice it lives in
# Bitwarden's agent instead (modules/nixos/bitwarden.nix), so the public half is named:
# ssh offers it and the agent signs, with no warning about a missing key file.
Match exec "test -f %d/.ssh/id_ed25519"
  IdentityFile ~/.ssh/id_ed25519
Match exec "test ! -f %d/.ssh/id_ed25519"
  IdentityFile ~/.ssh/id_ed25519.pub
