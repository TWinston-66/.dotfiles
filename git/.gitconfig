[user]
    name = "Winston T."
    email = "65579453+TWinston-66@users.noreply.github.com"

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[core]
    editor = zed --wait
    excludesfile = ~/.gitignore_global
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    features = gruvbox-material
    navigate = true
    line-numbers = true
    hyperlinks = true

[merge]
    conflictStyle = zdiff3

[diff]
    colorMoved = default

[color]
    ui = auto

[include]
    path = ~/.gitconfig.local

[url "git@github.com:"]
	pushInsteadOf = https://github.com/

# Gruvbox Material, blue accent. base16 takes its syntax colours
# from the terminal, which Ghostty sets to the same palette.
[delta "gruvbox-material"]
	blame-palette = "#282828 #222222 #1b1b1b #32302f #45403d"
	commit-decoration-style = "#7c6f64" bold box ul
	dark = true
	file-decoration-style = "#7c6f64"
	file-style = "#d4be98"
	hunk-header-decoration-style = "#7c6f64" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#baa88c"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#7c6f64"
	line-numbers-minus-style = bold "#ea6962"
	line-numbers-plus-style = bold "#a9b665"
	line-numbers-right-style = "#7c6f64"
	line-numbers-zero-style = "#7c6f64"
	minus-emph-style = bold syntax "#6c3f3c"
	minus-style = syntax "#4f3534"
	plus-emph-style = bold syntax "#555a3d"
	plus-style = syntax "#424434"
	map-styles = \
		bold purple => syntax "#644950", \
		bold blue => syntax "#465753", \
		bold cyan => syntax "#48584d", \
		bold yellow => syntax "#665438"
	syntax-theme = base16
